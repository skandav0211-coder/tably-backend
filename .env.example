# Server
NODE_ENV=development # Use production on Railway.
PORT=3000 # Local port; Railway sets this for the public service.
HOST=0.0.0.0 # Railway's proxy must reach the app on all interfaces.

# Database
DB_FILE=./billing.db # Set to /data/billing.db when Railway volume is mounted at /data.

# Authentication secrets (replace each with a different random value of at least 32 characters)
USER_JWT_SECRET=replace-this-user-jwt-secret-with-32-random-characters
ADMIN_JWT_SECRET=replace-this-admin-jwt-secret-with-32-random-characters
ENTITLEMENT_SECRET=replace-this-entitlement-secret-with-32-random-characters

# Admin bootstrap (ADMIN_PASSWORD is required in production, even when an admin already exists)
ADMIN_EMAIL=owner@example.com # Initial Super Admin email address.
ADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-12-chars

# Email (production defaults to Brevo API; set MAIL_TRANSPORT=smtp to use SMTP)
MAIL_TRANSPORT=console # Development default; production accepts api or smtp.
MAIL_FROM=verified-sender@example.com # Verified sender address for Brevo or SMTP.
BREVO_API_KEY=replace-with-your-brevo-api-key # Required when MAIL_TRANSPORT=api.
SMTP_HOST=smtp.example.com # Required when MAIL_TRANSPORT=smtp.
SMTP_PORT=587 # SMTP port.
SMTP_USER=replace-with-smtp-username # Optional only for unauthenticated SMTP relay.
SMTP_PASS=replace-with-smtp-password # Required when SMTP_USER is set.
SMTP_SECURE=false # Set to 1 for implicit TLS (port 465).

# CORS (exact portal origins, comma-separated; do not use wildcards in production)
ADMIN_PORTAL_ORIGINS=http://localhost:5173 # Comma-separated exact browser portal origins.

# Alerts
ALERT_WEBHOOK_URL= # Optional alert webhook URL.

# Off-site encrypted backups (required in production unless BACKUP_DISABLED=true)
BACKUP_DISABLED=false # Set true only to deliberately disable scheduled backups in production.
BACKUP_S3_ENDPOINT= # S3-compatible service endpoint, including https://.
BACKUP_S3_BUCKET= # Bucket name for encrypted database backups.
BACKUP_S3_KEY_ID= # Bucket access key ID.
BACKUP_S3_SECRET= # Bucket secret access key.
BACKUP_S3_REGION=auto # S3 region (use the value required by your provider).
BACKUP_ENCRYPTION_KEY= # Exactly 64 hex characters (32 random bytes); keep a separate secure copy.

# Admin recovery script only (set temporarily on the server when recovering access)
ADMIN_NEW_PASSWORD= # New password, minimum 12 characters.
ADMIN_NEW_EMAIL= # Optional replacement admin email address.
