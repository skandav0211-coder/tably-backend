[Unit]
Description=Tably billing backend
After=network.target

[Service]
Type=simple
User=tably
Group=tably
WorkingDirectory=/opt/tably/backend
EnvironmentFile=/etc/tably.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/tably
PrivateTmp=true

[Install]
WantedBy=multi-user.target
